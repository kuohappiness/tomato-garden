rules_version = '2';
// 番茄園讀書社：Firestore 安全規則
// 到 Firebase 主控台 → Firestore Database → 規則，整份貼上後按「發布」。
service cloud.firestore {
  match /databases/{database}/documents {

    // 一定要綁定 Google 帳號才算登入（免帳號、Email 的舊帳號要先在網站上綁定 Google）
    function signedIn() { return request.auth != null && 'google.com' in request.auth.token.firebase.identities; }
    function me() { return request.auth.uid; }
    function groupData(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data; }
    function isMember(gid) { return signedIn() && me() in groupData(gid).members; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // 番茄要專心滿這個讀書社的最短時間（minFocus，沒設就是 5 分鐘）才算數。
    // 開始專心時，studying.startedAt 一定要是伺服器時間（不能拿手機時間作假）；
    // 收成時再用伺服器時間檢查過了多久（容許 10 秒網路延遲）。
    function minFocus(gid) { return groupData(gid).get('minFocus', 5); }
    function memberPath(gid) { return /databases/$(database)/documents/groups/$(gid)/members/$(me()); }
    function startOk(st) { return st == null || st.startedAt == request.time; }
    function focusedLongEnough(gid, st) {
      return st != null && st.startedAt is timestamp
        && request.time >= st.startedAt + duration.value(minFocus(gid) * 60 - 10, 's');
    }

    // 珍奶星球「我要去睡覺了」：每次只能新增今天這一天（sleepDay），而且記下的時間一定要是伺服器時間；
    // 已經記下的日子不能改、不能刪（早睡珍珠用這個時間算）
    function sleepOk(before, after) {
      return after.sleepDay is string && after.sleep is map
        && after.sleep.diff(before.get('sleep', {})).addedKeys() == [after.sleepDay].toSet()
        && after.sleep.diff(before.get('sleep', {})).changedKeys().size() == 0
        && after.sleep.diff(before.get('sleep', {})).removedKeys().size() == 0
        && after.sleep[after.sleepDay] == request.time;
    }

    // 每個人自己的設定（加入了哪些群組）
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // 訪客參觀：只放全團合計（沒有任何人的名字），知道連結的人不用登入就能看
    match /guests/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isMember(request.resource.data.gid)
        && groupData(request.resource.data.gid).get('guestToken', '') == token
        && request.resource.data.keys().hasOnly(['gid','name','theme','subjects','examName','examDate','n','tom','min',
             'weekTom','weekMin','todayMin','todayTom','sm','lives','subj','week','updatedAt'])
        && (resource == null || resource.data.gid == request.resource.data.gid);
      allow delete: if signedIn() && groupData(resource.data.gid).owner == me();
    }

    // 讀書社名錄：只有名稱、角色、人數（沒有邀請碼），登入的人都看得到；只有建立這筆的團長能改
    match /directory/{did} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.by == me()
        && (resource == null || resource.data.by == me())
        && request.resource.data.keys().hasOnly(['name','theme','n','by','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if signedIn() && resource.data.by == me();
    }

    match /groups/{gid} {
      // 知道 6 碼邀請碼才能讀到群組（不能列出所有群組）
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.members == [me()];

      allow update: if signedIn() && (
        // 用邀請碼加入：只能把「自己」加進成員名單
        ( onlyChanged(['members'])
          && !(me() in resource.data.members)
          && !(me() in resource.data.get('banned', []))
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && me() in request.resource.data.members )
        ||
        // 退出：只能把「自己」移出；團長要先交棒，除非只剩自己一個人
        ( onlyChanged(['members'])
          && me() in resource.data.members
          && (resource.data.owner != me() || resource.data.members.size() == 1)
          && !(me() in request.resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1 )
        ||
        // 一般成員只能改考試名稱與日期
        ( me() in resource.data.members && onlyChanged(['examName', 'examDate']) )
        ||
        // 團長（建立者）可以改讀書社名稱、角色、科目、最短專心時間、考試設定
        ( resource.data.owner == me() && onlyChanged(['name', 'theme', 'subjects', 'minFocus', 'examName', 'examDate', 'guestToken', 'dirId'])
          && (!('minFocus' in request.resource.data)
              || (request.resource.data.minFocus is int && request.resource.data.minFocus >= 5 && request.resource.data.minFocus <= 180)) )
        ||
        // 團長可以移除、封鎖、解除封鎖成員（不能移除或封鎖自己）
        ( resource.data.owner == me() && onlyChanged(['members', 'banned'])
          && resource.data.members.hasAll(request.resource.data.members)
          && me() in request.resource.data.members
          && request.resource.data.get('banned', []) is list
          && !(me() in request.resource.data.get('banned', [])) )
        ||
        // 團長交棒：只能交給現有成員，名錄編號要清空（新團長會重新登記）
        ( resource.data.owner == me() && onlyChanged(['owner', 'dirId'])
          && request.resource.data.owner in resource.data.members
          && request.resource.data.owner != me()
          && request.resource.data.get('dirId', '') == '' )
      );

      allow delete: if signedIn() && resource.data.owner == me();

      // 成員資料（暱稱、番茄數、讀書分鐘）：大家看得到，只能改自己的
      // 番茄數（tomatoes、dt）不能隨便改：每次只能 +1，而且要從「開始專心」那一刻（伺服器時間）
      // 算起，已經滿這個讀書社的最短專心時間（minFocus）才行
      match /members/{uid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && me() == uid
          && request.resource.data.get('tomatoes', 0) == 0 && !('dt' in request.resource.data)
          && !('sleep' in request.resource.data)
          && startOk(request.resource.data.get('studying', null));
        allow update: if isMember(gid) && me() == uid
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studying'])
              || startOk(request.resource.data.get('studying', null)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sleep', 'sleepDay'])
              || sleepOk(resource.data, request.resource.data))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tomatoes', 'dt'])
              || ( request.resource.data.get('tomatoes', 0) == resource.data.get('tomatoes', 0) + 1
                   && request.resource.data.get('studying', null) == null
                   && focusedLongEnough(gid, resource.data.get('studying', null))
                   && request.resource.data.get('dt', {}).diff(resource.data.get('dt', {})).affectedKeys().size() == 1 ));
        allow delete: if isMember(gid) && me() == uid;
      }

      // 每個人登入的 Google 信箱：只有團長看得到；只能寫自己的，而且一定要是真的登入信箱
      match /contacts/{uid} {
        allow read: if signedIn() && groupData(gid).owner == me();
        allow write: if isMember(gid) && me() == uid
          && request.resource.data.keys().hasOnly(['email','name','at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 30
          && request.resource.data.email == request.auth.token.email;
      }

      // 考試範圍／任務：群組共用
      match /tasks/{tid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.createdBy == me();
        allow update, delete: if isMember(gid);
      }

      // 每個人的完成與熟練度：大家看得到，只能改自己的
      match /progress/{pid} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid) && request.resource.data.uid == me() && pid.matches(me() + '_.*');
        allow delete: if isMember(gid) && resource.data.uid == me();
      }

      // 社員自創角色：文件編號是「自己的 uid_該週星期一日期」，所以每人每週只能建一個；不能修改，只能刪除
      match /chars/{cid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.by == me() && cid.matches(me() + '_.*')
                      && request.resource.data.name is string && request.resource.data.name.size() <= 8;
        allow delete: if isMember(gid) && (resource.data.by == me() || groupData(gid).owner == me());
      }

      // 送寶物給隊友：文件編號是「自己的 uid_日期」，所以每人每天只能送一個；
      // 收禮的人只能標記已讀、回應，和回覆一句話（reply，10 字以內，只能回一次）
      match /sends/{sid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.from == me()
          && sid == me() + '_' + request.resource.data.date
          && request.resource.data.to in groupData(gid).members && request.resource.data.to != me()
          && request.resource.data.msg is string && request.resource.data.msg.size() <= 30
          && request.resource.data.keys().hasOnly(['from','to','item','msg','date','ts']);
        allow update: if isMember(gid) && resource.data.to == me() && onlyChanged(['seen','re','reply'])
          && (!('reply' in request.resource.data)
              || ('reply' in resource.data && request.resource.data.reply == resource.data.reply)
              || (!('reply' in resource.data) && request.resource.data.reply is string
                  && request.resource.data.reply.size() >= 1 && request.resource.data.reply.size() <= 10));
      }

      // 每一次番茄鐘紀錄
      match /sessions/{sid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.uid == me()
          && (request.resource.data.get('tomato', false) != true
              || ( request.resource.data.minutes is int
                   && request.resource.data.minutes >= minFocus(gid)
                   && focusedLongEnough(gid, get(memberPath(gid)).data.get('studying', null))
                   // 同一次寫入要把自己的番茄數 +1（並清掉 studying），一次開始只能換一顆
                   && getAfter(memberPath(gid)).data.get('tomatoes', 0) == get(memberPath(gid)).data.get('tomatoes', 0) + 1 ));
        allow delete: if isMember(gid) && resource.data.uid == me();
      }
    }
  }
}
